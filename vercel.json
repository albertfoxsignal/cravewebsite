{
  "redirects": [
    {
      "source": "/delete-account",
      "destination": "/data-deletion",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/post/:slug*",
      "destination": "/news",
      "permanent": true
    },
    {
      "source": "/blog/:slug*",
      "destination": "/news",
      "permanent": true
    },
    {
      "source": "/product-page/:slug*",
      "destination": "/menu",
      "permanent": true
    },
    {
      "source": "/category/:slug*",
      "destination": "/menu",
      "permanent": true
    },
    {
      "source": "/shop/:slug*",
      "destination": "/menu",
      "permanent": true
    },
    {
      "source": "/products/:slug*",
      "destination": "/menu",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/cravebot",
      "destination": "/cravebot.html"
    },
    {
      "source": "/menu",
      "destination": "/menu.html"
    },
    {
      "source": "/craveos",
      "destination": "/craveos.html"
    },
    {
      "source": "/news",
      "destination": "/news.html"
    },
    {
      "source": "/data-deletion",
      "destination": "/data-deletion.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms-of-service.html"
    },
    {
      "source": "/menu-form",
      "destination": "/menu-form.html"
    },
    {
      "source": "/sms-optin",
      "destination": "/sms-optin.html"
    },
    {
      "source": "/qr-guide",
      "destination": "/qr-guide.html"
    },
    {
      "source": "/events",
      "destination": "/events.html"
    },
    {
      "source": "/promo",
      "destination": "/promo.html"
    }
  ],
  "headers": [
    {
      "source": "/rcs-demo.mp4",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/promo",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}